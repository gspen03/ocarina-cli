FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app

COPY pom.xml .
RUN mvn dependency:go-offline

COPY src ./src
RUN mvn compile dependency:copy-dependencies -DoutputDirectory=target/lib

FROM eclipse-temurin:21-jre
WORKDIR /app

COPY --from=build /app/target.classes ./classes
COPY --from=build /app/target/lib ./lib

ENTRYPOINT ["java", "--enable-native-access=ALL-UNNAMED", "-cp", "classes:lib/*", "OcarinaCLI"]

